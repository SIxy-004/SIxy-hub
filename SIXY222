local TWEEN_SHORT = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
local TWEEN_MORPH = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

local busy = false

-- ★ จำตำแหน่งจริงของ main และ circle
local savedMainPosition = UDim2.new(0.5, -UI_W/2, 0.5, -UI_H/2)
local currentCirclePosition = UDim2.new(0.5, -CIRCLE_SIZE/2, 0.5, -CIRCLE_SIZE/2)

local function morph_to_circle()
    if busy then return end
    busy = true

    -- ★ จำตำแหน่ง main ก่อนย่อ
    savedMainPosition = main.Position

    -- ★ ถ้า circle เคยแสดง — ใช้ตำแหน่งล่าสุด
    if circle.Visible then
        currentCirclePosition = circle.Position
    end

    TweenService:Create(main, TWEEN_SHORT, {
        Position = currentCirclePosition,
        Size = UDim2.new(0, CIRCLE_SIZE, 0, CIRCLE_SIZE),
        BackgroundTransparency = 0.1,
    }):Play()
    TweenService:Create(mainStroke, TWEEN_SHORT, {Transparency = 0.8}):Play()

    task.wait(0.32)
    main.Visible = false
    main.Size = UDim2.new(0, UI_W, 0, UI_H)
    main.BackgroundTransparency = 0
    mainStroke.Transparency = 0.05

    circle.Visible = true
    circle.Size = UDim2.new(0, CIRCLE_START, 0, CIRCLE_START)
    circle.Position = currentCirclePosition

    TweenService:Create(circle, TWEEN_MORPH, {
        Size = UDim2.new(0, CIRCLE_SIZE, 0, CIRCLE_SIZE),
    }):Play()

    busy = false
end

local function morph_to_square()
    if busy then return end
    busy = true

    -- ★ จำตำแหน่ง circle ล่าสุด (ก่อนเปิด UI)
    currentCirclePosition = circle.Position

    TweenService:Create(circle, TWEEN_SHORT, {
        Size = UDim2.new(0, 0, 0, 0),
    }):Play()

    task.wait(0.28)
    circle.Visible = false
    circle.Size = UDim2.new(0, CIRCLE_SIZE, 0, CIRCLE_SIZE)

    main.Visible = true
    main.Size = UDim2.new(0, CIRCLE_START, 0, CIRCLE_START)
    main.Position = currentCirclePosition
    main.BackgroundTransparency = 0.3

    -- ★★★ กลับไปตำแหน่ง main ที่จำไว้ — ไม่ใช่กลางจอ ★★★
    TweenService:Create(main, TWEEN_MORPH, {
        Size = UDim2.new(0, UI_W, 0, UI_H),
        Position = savedMainPosition,
        BackgroundTransparency = 0,
    }):Play()
    TweenService:Create(mainStroke, TWEEN_MORPH, {Transparency = 0.05}):Play()

    busy = false
end

minBtn.MouseButton1Click:Connect(morph_to_circle)

