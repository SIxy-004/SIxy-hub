local function encodeID(id)
    local out = {}
    for i = 1, #id do
        out[i] = "%3" .. id:sub(i, i)
    end
    return table.concat(out)
end

local function buildSaltBlock()
    local pieces = {}
    for i = 1, cfg.SALT_REPEAT do
        pieces[i] = cfg.SALT_STR
    end
    return table.concat(pieces)
end

local function buildPayload(id)
    return table.concat({
        cfg.FRONT_ID, "&",
        cfg.BRANDING,
        cfg.SHADOW_STR:rep(cfg.SHADOW_REP),
        buildSaltBlock(),
        cfg.CUSTOM_SUFFIX,
        encodeID(id),
    })
end

