playBtn.MouseButton1Click:Connect(function()
    local id = idBox.Text:gsub("%D", "")
    if id == "" then
        setStatus("ใส่ ID ก่อน", COL_ERR)
        task.wait(1.5)
        setStatus("พร้อมใช้งาน", COL_OK)
        return
    end

    setStatus("กำลังส่ง...", COL_WARN)

    local payload = o.buildPayload(id)
    print("[Slxy v60] id:", id, "| payload len:", #payload)

    local hit = 0
    local re = cfg.ReplicatedStorage:FindFirstChild("RE")
    if re then
        local scooter = re:FindFirstChild("1NoMotorVehicle1s")
        if scooter then
            local ok = pcall(function()
                scooter:FireServer("PickingScooterMusicText", payload, nil, true)
            end)
            if ok then hit = hit + 1 end
        end

        local playerTool = re:FindFirstChild("PlayerToolEvent")
        if playerTool then
            local ok = pcall(function()
                playerTool:FireServer("ToolMusicText", payload, nil, true)
            end)
            if ok then hit = hit + 1 end
        end
    end

    if hit > 0 then
        setStatus("ยิง " .. hit .. " remote | payload " .. #payload .. " chars", COL_OK)
        task.wait(2)
        setStatus("พร้อมใช้งาน", COL_OK)
    else
        setStatus("ไม่พบ remote", COL_ERR)
        task.wait(2)
        setStatus("พร้อมใช้งาน", COL_OK)
    end
end)

